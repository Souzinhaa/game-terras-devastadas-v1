extends RefCounted
## Manual compartilhado. Texto acompanha a edição real e não consulta dados privados.
const Style = preload("res://scripts/ui_style.gd")

static func sections(modern: bool, lan: bool = false) -> Array:
	return [
		{"title": "Seu turno", "text": "[b]1. Compre a carta[/b] e resolva o que aparecer.\n[b]2. Viaje, se quiser[/b], antes de agir. Confira destino e combustível.\n[b]3. Faça a ação principal:[/b] explorar, conquistar, duelar, saquear ou uma operação marcada.\n[b]4. Encerre[/b] após resolver encontros e excesso de carga.\n\n[b]Símbolo 1 em círculo + âmbar[/b] indica uso da ação principal. Abastecer e transferir recursos são livres. Um evento de viagem pode gastar sua ação."},
		{"title": "Mapa, carga e depósitos", "text": "[b]Explorar:[/b] setor próprio na cidade atual; até [b]3 vezes por setor[/b]. " + ("Gera 2–3 itens no depósito, com 1 sucata ou combustível à sua escolha." if modern else "Gera 2–3 recursos sorteados no depósito.") + "\n\n[b]Carga ≠ depósito ≠ tanque.[/b] Retire do depósito para usar; combustível na carga precisa ser abastecido.\n\nToque em [b]Carga[/b] para abastecer, reparar, melhorar ou descartar. Use [b]Depósitos[/b] para guardar e retirar. Carga no limite é permitida; só o excesso precisa ser resolvido." + ("\n\n[b]Troca livre:[/b] 1 água, pneu ou bateria da carga por 1 sucata; uma vez por turno próprio, fora de encontros." if modern else "")},
		{"title": "Veículo e equipamentos", "text": "[b]Reparo simples:[/b] 1 sucata por +1 estrutura; livre, uma vez por turno.\n[b]Reparo maior:[/b] 2 sucatas por até +4 estrutura; usa a ação principal.\n[b]Comprar equipamento:[/b] 3 sucatas da carga; uma compra por turno, sem ação. O baralho também contém melhorias territoriais.\n[b]Trocar o Hatch:[/b] 5 sucatas próprias da cidade (carga + depósitos) e a ação principal. " + ("Preserva estrutura, combustível e vidas." if modern else "Preserva estrutura e vidas; nesta edição a Moto recebe 10 combustíveis.") + "\n\n[b]Defesa básica:[/b] " + ("Hatch 3+; Sedã, SUV e Caminhonete 4+; Moto 5+." if modern else "Hatch, Sedã e Moto 4+; SUV e Caminhonete 3+.") + "\n[b]Espaços:[/b] até 2 equipamentos no veículo. " + ("Equipamentos da Moto não ocupam carga." if modern else "Confira o peso dos equipamentos.") + " Instalação territorial remota usa a ação principal."},
		{"title": "Combate", "text": "[b]Antes do dado:[/b] cada jogador indicado escolhe uma carta de efeito ou passa. Depois, o nome e a cor mostram [b]quem rola[/b]. O atacante controla o dado dos hostis e fortificações.\n\n[b]Acerto:[/b] D6 + modificadores precisa alcançar a Defesa. [b]1 natural erra; 6 natural acerta.[/b]\n\n[b]Gerais:[/b] " + ("uma por pessoa a cada rodada de combate, compartilhada entre ataque e fuga. A cota do mapa é separada." if modern else "uma por pessoa a cada turno do mapa, inclusive no combate.") + "\n[b]Armas:[/b] a fixa não gasta munição. Um ataque adicional por veículo/rodada; paga munição mesmo ao errar.\n[b]Fuga:[/b] escolha uma estrada legal quando a opção aparecer.\n\n[b]Passar nas próximas rolagens[/b] só pula suas reações; pode ser desfeito antes do dado."},
		{"title": "Corrida surpresa e saque", "text": "[b]Corrida:[/b] custa 1 combustível para entrar; mínimo de 2 inscritos. Sem isso, a inscrição é devolvida e não há prêmio. " + ("Participar é opcional." if modern else "O revelador apto, com combustível, deve entrar.") + "\n\n[b]CARTAS DE EFEITO · nome[/b] indica quem reage. Esse jogador usa uma carta ou passa.\n[b]DADO · nome[/b] indica quem rola o avanço. Cada rolagem pode abrir uma nova janela de efeitos. Após entrar, não há desistência voluntária.\n\n[b]Saque:[/b] ação principal + 1 combustível, em depósito rival local. " + ("D6 contra D6" if modern else "D6 contra D6+1") + "; empate favorece a defesa. Sucesso leva até 2 recursos (1 com T05); falha causa 2 danos. Defesa pessoal substitui o teste por combate de carros."},
		{"title": "Vitória e duas vidas", "text": "Vença como [b]último sobrevivente[/b] ou sustente [b]%d pontos[/b] de cidades completas. Anuncie ao encerrar e mantenha até seu próximo início.\n\nCidade com 4 setores vale [b]1 ponto[/b]; demais cidades completas, [b]0,5[/b]. Consulte [b]Menu → Partida → Placar[/b].\n\n[b]Primeira destruição:[/b] perde o que transportava e renasce de Hatch íntegro com 3 combustíveis. Territórios e depósitos permanecem. " % (3 if modern else 4) + ("Fica protegido até o próximo início próprio, sem perder a vez." if modern else "Nesta edição, perde o próximo turno próprio.") + "\n[b]Segunda destruição:[/b] elimina. Trocar ou reparar o veículo não devolve vidas."},
		{"title": "Jogadores e Tabuleiro/TV", "text": ("[b]LAN:[/b] cada pessoa joga no próprio celular. Responda quando seu nome aparecer, mesmo fora do seu turno.\n\n[b]Sala:[/b] nome e senha são opcionais. Mesma rede e mesma build; o anfitrião precisa manter o app aberto. Não há migração de anfitrião." if lan else "[b]Local:[/b] passe o celular no fim do turno. Confirme a identidade antes de abrir cartas. Os nomes ficam lembrados para a próxima partida.\n\n[b]Antes de começar:[/b] use Conectar Tabuleiro/TV na preparação. A sala tem o nome do jogador 1. Também pode conectar pelo menu durante a partida.") + "\n\n[b]Tabuleiro/TV:[/b] mostra só dados públicos. Mãos, carga e depósitos continuam privados.\n[b]Voltar:[/b] fecha leitura ou prévia sem executar a ação."}
	]

static func render_topic(parent: Control, entry: Dictionary) -> RichTextLabel:
	var text := RichTextLabel.new()
	text.name = "ManualText"
	text.bbcode_enabled = true
	text.fit_content = true
	text.scroll_active = false
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	text.add_theme_font_override("normal_font", Style.BODY)
	text.add_theme_font_override("bold_font", Style.STRONG)
	text.add_theme_color_override("default_color", Style.TEXT)
	text.add_theme_font_size_override("normal_font_size", parent.get_theme_default_font_size())
	text.add_theme_font_size_override("bold_font_size", parent.get_theme_default_font_size())
	text.text = str(entry.text)
	parent.add_child(text)
	return text
